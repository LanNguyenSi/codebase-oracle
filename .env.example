# Values are used literally: no ~ or $VAR expansion, and a trailing
# "# comment" becomes part of the value. Keep comments on their own lines.

# Required
OPENAI_API_KEY=sk-...
ORACLE_SCAN_ROOT=/path/to/your/repos

# Optional — for Claude-powered answers (falls back to OpenAI if not set)
# ANTHROPIC_API_KEY=sk-ant-...

# Optional — provider selection
# openai | ollama
# ORACLE_EMBEDDING_PROVIDER=openai
# auto | anthropic | openai | openai-compatible | ollama
# ORACLE_LLM_PROVIDER=auto
#
# Optional — OpenAI-compatible endpoints (e.g. proxies)
# OPENAI_BASE_URL=https://api.openai.com/v1
#
# Optional — Ollama (used when *_PROVIDER=ollama)
# With ORACLE_EMBEDDING_PROVIDER=ollama and no OLLAMA_API_KEY, OPENAI_API_KEY
# is sent to the Ollama endpoint. Set OLLAMA_API_KEY to prevent that.
# OLLAMA_API_KEY=ollama
# ORACLE_OLLAMA_BASE_URL=http://localhost:11434/v1
#
# Optional — override defaults
# Absolute path (default: $HOME/.codebase-oracle)
# ORACLE_DATA_DIR=/absolute/path/to/.codebase-oracle
# OpenAI default: text-embedding-3-small, Ollama default: nomic-embed-text
# ORACLE_EMBEDDING_MODEL=text-embedding-3-small
# Default: claude-sonnet-4-6 (anthropic, auto, openai-compatible), gpt-4o-mini (openai),
# llama3.1 (ollama). Ignored when auto falls back to OpenAI, which always uses gpt-4o-mini.
# ORACLE_LLM_MODEL=claude-sonnet-4-6
# Bound on every LLM request (raise for a slow local setup); see docs/configuration.md
# ORACLE_LLM_TIMEOUT_MS=120000
