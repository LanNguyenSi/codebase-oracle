{
  "name": "@lannguyensi/codebase-oracle",
  "version": "0.10.2",
  "description": "RAG-powered codebase Q&A for multi-repo codebases, with LangChain and MCP server",
  "type": "module",
  "bin": {
    "codebase-oracle": "./dist/index.js"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "test": "vitest run --coverage",
    "test:typecheck": "tsc --noEmit -p tsconfig.tests.json",
    "build": "tsc",
    "dev": "tsx src/index.ts",
    "index": "tsx src/index.ts index",
    "query": "tsx src/index.ts query",
    "watch": "tsx src/index.ts watch",
    "mcp": "tsx src/mcp-server.ts",
    "serve": "tsx src/http-server.ts",
    "migrate-store": "tsx src/index.ts migrate-store",
    "eval": "tsx tests/eval/runner.ts",
    "prepublishOnly": "npm run build"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/LanNguyenSi/codebase-oracle.git"
  },
  "keywords": [
    "rag",
    "langchain",
    "mcp",
    "codebase",
    "search"
  ],
  "author": "LanNguyenSi",
  "license": "MIT",
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "@langchain/anthropic": "^1.3.26",
    "@langchain/core": "^1.1.40",
    "@langchain/openai": "^1.4.4",
    "@langchain/textsplitters": "^1.0.1",
    "@modelcontextprotocol/sdk": "^1.29.0",
    "better-sqlite3": "^12.9.0",
    "chokidar": "^5.0.0",
    "commander": "^14.0.3",
    "langchain": "^1.3.3",
    "picomatch": "^4.0.4",
    "sqlite-vec": "^0.1.9",
    "yaml": "^2.9.0",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^25.6.0",
    "@types/picomatch": "^4.0.3",
    "@vitest/coverage-v8": "4.1.4",
    "tsx": "^4.22.4",
    "typescript": "^6.0.2",
    "vitest": "4.1.4"
  },
  "overrides": {
    "uuid": "^14.0.0",
    "@anthropic-ai/sdk": "^0.91.1",
    "ip-address": "^10.1.1"
  }
}
